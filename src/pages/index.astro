---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Timeline from '../components/Timeline.astro';
import WorkSection from '../components/WorkSection.astro';
import PrinciplesSection from '../components/PrinciplesSection.astro';
import ToolboxSection from '../components/ToolboxSection.astro';
import OpenSourceSection from '../components/OpenSourceSection.astro';
import ContactSection from '../components/ContactSection.astro';
---

<BaseLayout>
  <!-- Masthead Hero -->
  <Hero />

  <!-- Four-Year Activity Swimlane (2022–2026) -->
  <Timeline />

  <!-- Case Files: Selected Work (01–08) -->
  <WorkSection />

  <!-- How I Work: Evidenced Principles -->
  <PrinciplesSection />

  <!-- Technologies in Active Rotation -->
  <ToolboxSection />

  <!-- Open Source Repositories & Experiments -->
  <OpenSourceSection />

  <!-- Contact & Collaboration -->
  <ContactSection />
</BaseLayout>
