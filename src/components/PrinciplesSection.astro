---
import { principles } from '../data/principles';
---

<section id="approach" class="py-16 sm:py-20 border-b" style="border-color: var(--rule-subtle);">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="max-w-2xl mb-12">
      <div class="text-xs font-mono uppercase tracking-wider mb-2" style="color: var(--accent);">
        Engineering Philosophy
      </div>
      <h2 class="text-3xl sm:text-4xl tracking-tight" style="font-family: var(--font-serif); color: var(--ink);">
        How I approach mobile systems
      </h2>
      <p class="text-xs sm:text-sm mt-1" style="color: var(--muted);">
        Practices developed across production apps running in retail stores, municipal offices, and transit corridors. Every principle backed by code in the checkouts.
      </p>
    </div>

    <!-- 2x2 Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {principles.map((p) => (
        <div class="p-6 rounded-xl border flex flex-col justify-between space-y-5" style="background-color: var(--surface); border-color: var(--rule-subtle);">
          <div>
            <span class="font-mono text-xs font-bold px-2 py-1 rounded inline-block mb-3" style="background-color: var(--surface-subtle); color: var(--accent); border: 1px solid var(--rule-subtle);">
              {p.number}
            </span>
            <h3 class="text-lg sm:text-xl font-bold tracking-tight mb-2" style="font-family: var(--font-serif); color: var(--ink);">
              {p.title}
            </h3>
            <p class="text-xs sm:text-sm leading-relaxed" style="color: var(--ink-secondary);">
              {p.summary}
            </p>
          </div>

          <div class="pt-4 border-t text-xs font-mono" style="border-color: var(--rule-subtle); color: var(--muted);">
            <span class="font-semibold block mb-1" style="color: var(--accent);">Evidence in code:</span>
            <span>{p.evidence}</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
